# Copy to `.env` and fill in. `.env` must never be committed.

# SQLite file, resolved relative to the project root.
DATABASE_URL="file:./dev.db"

# Secret used to sign session tokens.
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public origin of the deployment (used for absolute links in emails/receipts).
APP_URL="http://localhost:3000"

# Demo accounts created by `npm run db:seed`. Change before deploying anywhere real.
SEED_ADMIN_EMAIL="admin@grillcorn.test"
SEED_ADMIN_PASSWORD="Admin!2345"
SEED_STAFF_EMAIL="staff@grillcorn.test"
SEED_STAFF_PASSWORD="Staff!2345"
SEED_CUSTOMER_EMAIL="customer@grillcorn.test"
SEED_CUSTOMER_PASSWORD="Customer!2345"
